<mxfile>
  <diagram id="uc1" name="Use Case Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- System Box -->
        <mxCell id="system" value="Smart Inventory AI System" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="250" y="50" width="400" height="650" as="geometry" />
        </mxCell>
        
        <!-- Actors -->
        <mxCell id="manager" value="Inventory Manager" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#f9f9f9;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="analyst" value="AI System" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#f9f9f9;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="Admin User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#f9f9f9;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="550" width="40" height="80" as="geometry" />
        </mxCell>
        
        <!-- Use Cases -->
        <mxCell id="uc1" value="Manage Products<br/>CRUD Operations" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4caf50;strokeWidth=2;" vertex="1" parent="system">
          <mxGeometry x="100" y="50" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc2" value="View Demand Forecasts<br/>Predictions" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4caf50;strokeWidth=2;" vertex="1" parent="system">
          <mxGeometry x="100" y="150" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="Generate Reports<br/>Charts &amp; Insights" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4caf50;strokeWidth=2;" vertex="1" parent="system">
          <mxGeometry x="100" y="250" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="View Real-Time Dashboard" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4caf50;strokeWidth=2;" vertex="1" parent="system">
          <mxGeometry x="100" y="350" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc5" value="Export Analytics Data" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4caf50;strokeWidth=2;" vertex="1" parent="system">
          <mxGeometry x="100" y="450" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc6" value="Manage Users &amp; Security" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4caf50;strokeWidth=2;" vertex="1" parent="system">
          <mxGeometry x="100" y="550" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <mxCell id="edge1" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="manager" target="uc1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge2" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="manager" target="uc2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge3" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="manager" target="uc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="edge4" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="analyst" target="uc2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge5" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="analyst" target="uc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge6" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="analyst" target="uc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge7" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="analyst" target="uc5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="edge8" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="admin" target="uc6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
